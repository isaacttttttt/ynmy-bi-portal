# ==============================================================================
# 云南白药集团 · BI 数据门户运行环境配置模板（portal.env.example）
# 使用说明：复制为 conf/portal.env 并填入实际密码与内网地址，修改后需重建/重启容器生效。
# 安全提醒：请勿将包含真实密码的 portal.env 提交到代码仓库。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 基础服务配置
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=3001
# 父平台（帆软）与门户在浏览器中的统一访问源（协议+域名+非默认端口，不带路径）
PUBLIC_ORIGIN=https://bi.ynby.cn
# 容器内运行日志输出路径（对应宿主机挂载的 logs/ 目录）
PORTAL_LOG_FILE=/app/logs/portal.log

# ------------------------------------------------------------------------------
# 2. 门户主库 PostgreSQL（存放业务底表与门户配置/搜索历史表，位于 public schema）
#    需包含表：dim_bi_report_info_dtl、dim_bi_report_dictionary、dim_bi_user、
#              dim_dept_mapping、dim_bi_visit_log、fr_index_noticement、
#              fr_quick_entry_app、portal_search_history、
#              portal_role_thematic_config、portal_role_thematic_node
# ------------------------------------------------------------------------------
DB_HOST=pg.customer.internal
DB_PORT=5432
DB_NAME=finedb_ext
DB_USER=portal_reader
DB_PASSWORD="替换为门户主库密码"
# 内网允许非 TLS 时填 disable；需校验证书时填 verify-full 并挂载 ca.crt
DB_SSL_MODE=disable
# 单条 SQL 最大执行超时时间（毫秒，同时适用于读/写语句）
DB_STATEMENT_TIMEOUT_MS=60000
# 启用 TLS 时取消注释，并将企业 CA 证书放到 conf/ca.crt
# DB_SSL_CA_FILE=/app/config/ca.crt

# ------------------------------------------------------------------------------
# 3. 帆软平台 7.0 独立 FineDB 只读库 PostgreSQL（用于实时查询用户角色与角色-报表权限）
#    仅需只读访问：fine_user、fine_user_role_middle、fine_custom_role、
#                  fine_authority、fine_authority_object
#    注：仅当 FineDB 表与门户主库在同一个 PG 实例时，才将 FINEDB_HOST 留空。
# ------------------------------------------------------------------------------
FINEDB_HOST=10.11.8.172
FINEDB_PORT=6449
FINEDB_NAME=finedb7_prod_db
FINEDB_USER=finedb7_prod
FINEDB_PASSWORD="替换为FineDB只读库密码"
FINEDB_SSL_MODE=disable
# FineDB 表所在 schema（独立库默认 public；共用主库时默认 finedb）
FINEDB_SCHEMA=public
# 热缓存时间（秒）：降低并发刷新对 FineDB 的 QPS 与 PG 内存压力；设为 0 可关闭持久缓存（保留并发合并）
FINEDB_USER_ROLES_CACHE_TTL_SECONDS=30
FINEDB_OBJECT_TREE_CACHE_TTL_SECONDS=30

# ------------------------------------------------------------------------------
# 4. 后端 -> 帆软平台接口配置（容器内网可达地址）
#    下方各接口路径会自动拼接在 FINE_BASE_URL 后，也可直接填写完整 URL
# ------------------------------------------------------------------------------
FINE_BASE_URL=http://finebi.customer.internal:8080/WebReport/ReportServer
# 帆软认证 Token Cookie 名称
FINE_COOKIE_NAME=fine_auth_token
# 身份识别模式：trusted-cookie（由企业网关校验 Cookie 后透传）或 session（调用校验接口）
FINE_IDENTITY_MODE=trusted-cookie
# 登录用户 ID Cookie 名称（对应 dim_bi_user.id；多账号逗号分隔时按 Token sub 匹配当前用户名）
FINE_USER_COOKIE_NAME=fine_login_users
# 若切换为 FINE_IDENTITY_MODE=session，请配置已验证的身份接口路径
# FINE_SESSION_PATH=/your-session-endpoint

# 帆软目录树接口（按路由按需拉取，公告/搜索历史/角色配置页不拉取）
FINE_TREE_PATH=/v10/view/entry/tree
# 单节点会话级目录树缓存时间（秒）；设为 0 时仅保留并发请求合并
FINE_TREE_CACHE_TTL_SECONDS=60
# 会话级身份缓存与 /v10/roles 列表缓存时间（秒）；设为 0 关闭持久缓存
FINE_IDENTITY_CACHE_TTL_SECONDS=60
FINE_ROLES_CACHE_TTL_SECONDS=60
# 跨用户共享的专题目录树缓存（配置页保存后立即失效）与 T+1 公共字典元数据缓存（秒）
PORTAL_THEMATIC_CACHE_TTL_SECONDS=60
PORTAL_CATALOG_CACHE_TTL_SECONDS=60
# 目录树缓存最大会话数上限（0 表示不限制会话数，仅受下方内存预算控制）
FINE_TREE_CACHE_MAX_ENTRIES=0
# 目录树缓存序列化数据体积预算（MB，非进程总内存限制）
FINE_TREE_CACHE_MAX_MB=512

# 帆软收藏夹接口
FINE_FAVORITES_PATH=/v10/favorite/entry/list
FINE_FAVORITE_ADD_PATH=/v10/favorite/entry/{entryId}
FINE_FAVORITE_ADD_METHOD=POST
FINE_FAVORITE_REMOVE_PATH=/v10/favorite/entry/{entryId}?fakeMethod=DELETE
FINE_FAVORITE_REMOVE_METHOD=POST

# 帆软角色列表接口（用于独立挂载页 /portal/role-thematic-config/）
FINE_ROLES_PATH=/v10/roles
FINE_ROLES_PRIVILEGE_TYPE=2

# 可选：旧版专题根目录 ID（当前专题分析已切换为按角色配置表展示，建议留空以节省目录树内存）
FINE_ROOT_ID=

# ------------------------------------------------------------------------------
# 5. 浏览器侧 / 父平台跳转地址配置（严禁填写 Docker 内部服务名）
# ------------------------------------------------------------------------------
FINE_BROWSER_BASE_URL=/WebReport/ReportServer
FINE_ENTRY_ACCESS_PATH=/v10/entry/access/{entryId}
FINE_BI_SERVICE_NAME=dec.service.frame.tab_pane
FINE_BI_TAB_TYPE=bi.subject.publink
# 可选：自定义报表图标 URL 模板，留空则使用本地默认图标
# 示例：/files/imgs/{entryId}.png 或 https://bi.ynby.cn/files/imgs/{entryId}.png
FINE_ICON_URL_TEMPLATE=

# 备注：工作台「最近打开」与「我常用的」读取门户主库 dim_bi_visit_log，无需配置平台最近访问接口。
