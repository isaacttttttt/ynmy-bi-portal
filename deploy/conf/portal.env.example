# Copy to portal.env. Restart the container after editing. Do not commit secrets.
HOST=0.0.0.0
PORT=3001
# Browser origin of BOTH the parent FineBI platform and this embedded portal.
PUBLIC_ORIGIN=https://bi.customer.example
PORTAL_DATA_MODEL=source

# PostgreSQL: customer business tables must already exist in public schema.
DB_HOST=pg.customer.internal
DB_PORT=5432
DB_NAME=bi_portal
DB_USER=portal_reader
DB_PASSWORD="REPLACE_WITH_CUSTOMER_PASSWORD"
DB_SSL_MODE=disable
# For TLS: DB_SSL_MODE=verify-full; mount ca.crt in the conf directory.
# DB_SSL_CA_FILE=/app/config/ca.crt

# Container -> platform. Paths are appended to this base, or may be full URLs.
FINE_BASE_URL=http://finebi.customer.internal:8080/WebReport/ReportServer
FINE_COOKIE_NAME=fine_auth_token
# Customer gateway validates both cookies and binds them to the same logged-in user.
FINE_IDENTITY_MODE=trusted-cookie
# This cookie is dim_bi_user.id, NOT username; the backend resolves the enabled user's username.
FINE_USER_COOKIE_NAME=fine_login_users
# Optional alternative: FINE_IDENTITY_MODE=session with a verified identity endpoint.
# FINE_SESSION_PATH=/your-session-endpoint
FINE_TREE_PATH=/v10/view/entry/tree
FINE_FAVORITES_PATH=/v10/favorite/entry/list
FINE_FAVORITE_ADD_PATH=/v10/favorite/entry/{entryId}
FINE_FAVORITE_ADD_METHOD=POST
FINE_FAVORITE_REMOVE_PATH=/v10/favorite/entry/{entryId}?fakeMethod=DELETE
FINE_FAVORITE_REMOVE_METHOD=POST
# Root directory for thematic analysis. Visible reports still follow user tree permissions.
FINE_ROOT_ID=REPLACE_WITH_TOP_DIRECTORY_ID

# Browser / parent platform URLs: do NOT use Docker service names here.
FINE_BROWSER_BASE_URL=/WebReport/ReportServer
FINE_ENTRY_ACCESS_PATH=/v10/entry/access/{entryId}
FINE_BI_SERVICE_NAME=dec.service.frame.tab_pane
FINE_BI_TAB_TYPE=bi.subject.publink
# Optional. Local defaults remain visible until the remote image decodes.
# Example: /files/imgs/{entryId}.png or https://bi.customer.example/files/imgs/{entryId}.png
FINE_ICON_URL_TEMPLATE=

# Recent and frequent reports use PG visit logs, not a platform recent-list API.
# Keep POC_PLATFORM_URL unset: customer image must not expose the test login gateway.
