HOST=::
PORT=3001
PUBLIC_ORIGIN=https://your-portal.example.com
DB_HOST=pg.customer.internal
DB_PORT=5432
DB_NAME=bi_portal
DB_USER=portal_reader
DB_PASSWORD=
DB_STATEMENT_TIMEOUT_MS=60000
FINE_BASE_URL=https://your-finebi.example.com/webroot/decision
# Authenticated identity adapter path, agreed with the platform team. Not a claimed built-in FineBI endpoint.
FINE_SESSION_PATH=/your-session-adapter
FINE_ROOT_ID=your-top-directory-id
# 报表字典 FineDB 目录缓存 TTL（秒）与后台定时刷新周期（秒）
FINEDB_DIRECTORY_CACHE_TTL_SECONDS=300
FINEDB_DIRECTORY_REFRESH_INTERVAL_SECONDS=240
